{
  "uid": "sites-overview",
  "title": "Sites Overview",
  "description": "Every tzsp-monitor site at once. Generated at Grafana start from the REMOTE_SITE_* lines in properties.yml by grafana/entrypoint/sites.sh -- edit grafana/entrypoint/overview/, not this dashboard.",
  "tags": [
    "tzsp",
    "sites"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Sites (click a site to open its Network Monitor)",
      "description": "One row per site, read live from that site's own InfluxDB. The status columns are the same readings, words and thresholds as that site's own health tiles (Monitoring Feed, IDS Feed, Capture Loss, Disk Used, Disk Guard, DNS Monitor, Router API). UNREACHABLE means this Grafana could not query the site at all -- the panel's error icon names the address -- which is a different thing from a site whose pipeline is down. Counts cover the dashboard time range.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "targets": [
        {"refId": "__SITE__", "datasource": {"type": "influxdb", "uid": "__UID__"}, "query": "@health.flux"},
        {
          "refId": "_expected",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "infinity"
          },
          "type": "json",
          "source": "inline",
          "format": "table",
          "parser": "backend",
          "data": "__SITES_JSON__",
          "columns": [
            {
              "selector": "site",
              "text": "site",
              "type": "string"
            },
            {
              "selector": "site_uid",
              "text": "site_uid",
              "type": "string"
            }
          ]
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "site": 0,
              "reachable": 1,
              "flow_age": 2,
              "ids_age": 3,
              "capture_loss": 4,
              "disk_used": 5,
              "disk_guard": 6,
              "dns_monitor": 7,
              "router_api": 8,
              "traffic": 9,
              "alerts": 10,
              "crit_high": 11,
              "blocked": 12,
              "site_uid": 13
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "site",
                "desc": false
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "center",
            "cellOptions": {
              "type": "auto"
            },
            "minWidth": 60
          },
          "decimals": 0,
          "unit": "none"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "site"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Site"
              },
              {
                "id": "custom.align",
                "value": "left"
              },
              {
                "id": "custom.width",
                "value": 100
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open ${__value.text} in Network Monitor",
                    "url": "/d/tzsp-network-monitor?var-site=${__data.fields.site_uid}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "site_uid"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "reachable"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Site API"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "REACHABLE",
                        "color": "#0ca30c",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "special",
                    "options": {
                      "match": "null",
                      "result": {
                        "text": "UNREACHABLE",
                        "color": "#d03b3b",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
