    {
      "id": 6,
      "type": "timeseries",
      "title": "Throughput by Site",
      "description": "Each site's collector throughput, stacked, so the top edge is the total. Colours are assigned by site name, so adding a site does not repaint the others. ~96 buckets whatever the range, labelled at their start, like the other boards.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "targets": [
        {"refId": "__SITE__", "datasource": {"type": "influxdb", "uid": "__UID__"}, "query": "@throughput.flux"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 35,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0,
            "gradientMode": "none"
          },
          "color": {
            "mode": "palette-classic-by-name"
          },
          "displayName": "${__field.labels.site}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
