   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "${site}"
     },
     "query": "spanNs = int(v: v.timeRangeStop) - int(v: v.timeRangeStart)\nevery = if spanNs / 96 < int(v: 1m) then 1m else duration(v: spanNs / 96)\n\nfrom(bucket: \"network_traffic\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"alert_dispatch\" and r._field == \"count\")\n  |> aggregateWindow(every: every, fn: sum, createEmpty: false, timeSrc: \"_start\")\n  |> group(columns: [\"source\"])\n  |> aggregateWindow(every: every, fn: sum, createEmpty: false, timeSrc: \"_start\")\n  |> map(fn: (r) => ({r with _field: r.source}))\n",
     "rawQuery": true,
     "resultFormat": "time_series"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 80,
