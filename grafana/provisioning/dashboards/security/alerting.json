    "orientation": "auto",
    "textMode": "value",
    "colorMode": "none",
    "graphMode": "none",
    "justifyMode": "center",
    "wideLayout": true,
    "showPercentChange": false,
    "text": {
     "titleSize": 16,
     "valueSize": 16
    }
   }
