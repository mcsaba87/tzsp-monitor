  {
   "type": "table",
   "id": 7,
   "title": "Pending Command Change -- Confirm to apply",
   "description": "A command typed into the Command box is staged here, not applied. Confirm carries a one-time code the alerter made when the change was staged, so a link that someone else prepared with a command in it cannot apply it by being opened. A staged change expires after 15 minutes. Empty: nothing staged.",
   "gridPos": {
    "h": 5,
    "w": 24,
    "x": 0,
    "y": 15
   },
   "datasource": {
    "type": "yesoreyeram-infinity-datasource",
    "uid": "infinity"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "yesoreyeram-infinity-datasource",
      "uid": "infinity"
     },
     "type": "json",
     "parser": "backend",
     "source": "url",
     "format": "table",
     "url": "http://alerter:8090/pending?enable=${enable:percentencode}&disable=${disable:percentencode}&severity=${severity:percentencode}&command_for=${command_for:percentencode}&command=${command:percentencode}&confirm=${confirm:percentencode}&cancel=${cancel:percentencode}&test=${test:percentencode}&site=${site}",
     "url_options": {
      "method": "GET"
     },
     "root_selector": "",
     "columns": [
      {
       "selector": "name",
       "text": "name",
       "type": "string"
      },
      {
       "selector": "current",
       "text": "current",
       "type": "string"
      },
      {
       "selector": "new",
       "text": "new",
       "type": "string"
      },
      {
       "selector": "expires",
       "text": "expires",
       "type": "string"
      },
      {
       "selector": "confirm",
       "text": "confirm",
       "type": "string"
      },
