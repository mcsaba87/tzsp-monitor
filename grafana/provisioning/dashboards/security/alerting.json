   "type": "timeseries",
   "id": 8,
   "title": "Alerts Sent, by Source",
   "description": "Commands run per source (tests included), in ~96 buckets across the time range, labelled by the bucket's start.",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 20
