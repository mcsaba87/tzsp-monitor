     },
     "type": "json",
     "parser": "backend",
     "source": "url",
     "format": "table",
     "url": "http://alerter:8090/status?enable=${enable:percentencode}&disable=${disable:percentencode}&severity=${severity:percentencode}&command_for=${command_for:percentencode}&command=${command:percentencode}&confirm=${confirm:percentencode}&cancel=${cancel:percentencode}&test=${test:percentencode}&site=${site}",
     "url_options": {
