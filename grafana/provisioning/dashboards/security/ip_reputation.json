  {
   "type": "stat",
   "title": "Dropped in Range",
   "description": "Packets the rules referencing the list dropped over the selected time range, from their RouterOS counters. The only evidence the list is doing anything. NO DATA means ip-reputation is not running or cannot read the rules.",
   "id": 4,
   "gridPos": {
    "h": 5,
    "w": 5,
    "x": 14,
    "y": 0
   },
   "datasource": {
    "type": "influxdb",
    "uid": "InfluxDB_Flux"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "InfluxDB_Flux"
     },
     "query": "import \"array\"\n// rule_packets is already a per-minute delta of the rules' counters, so the\n// sum over the range is what they dropped in it. The -1 row keeps a stopped\n// service from reading as \"nothing to drop\".\ndata = from(bucket: \"network_traffic\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"ip_reputation_router\" and r._field == \"rule_packets\")\n  |> sum()\n  |> group()\n  |> sum()\nsentinel = array.from(rows: [{_value: -1}])\nunion(tables: [data, sentinel])\n  |> max()\n"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#9ca3af",
        "value": null
       },
       {
        "color": "#3b82f6",
        "value": 0
       }
      ]
     },
     "noValue": "NO ANSWER",
     "mappings": [
      {
       "type": "value",
       "options": {
        "-1": {
         "text": "NO DATA",
         "color": "#9ca3af",
         "index": 0
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
