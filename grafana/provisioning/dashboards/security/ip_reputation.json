{
 "uid": "ip-reputation",
 "title": "IP Reputation Blocking",
 "description": "Public IP reputation feeds (Spamhaus DROP, abuse.ch Feodo, ...) merged onto one Mikrotik address list. A control surface: the two tables perform the changes they display.",
 "tags": [
  "security",
  "mikrotik",
  "blocklist",
  "reputation"
 ],
