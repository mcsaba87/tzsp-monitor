  "to": "now"
 },
 "timepicker": {},
 "annotations": {
  "list": []
 },
 "templating": {
  "list": [
   {
    "name": "enable_feed",
    "type": "textbox",
    "label": "Add feed",
    "description": "The feed to start using. Normally filled by clicking a row in the catalogue. Harmless to leave filled: adding a feed that is already on is a no-op, and it wins over a stale remove box.",
    "query": "",
    "current": {
     "selected": false,
     "text": "",
     "value": ""
    },
    "options": [],
    "hide": 0,
    "skipUrlSync": false
   },
   {
    "name": "disable_feed",
