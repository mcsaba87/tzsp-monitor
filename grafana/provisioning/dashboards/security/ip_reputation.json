  {
   "type": "timeseries",
   "title": "Dropped by the Reputation Rules",
   "id": 6,
   "description": "Packets dropped by the firewall rules that reference the list (bars), with the number of entries on the router (line, right axis). Flat zero bars with entries loaded and rules present simply means nothing on the list tried to talk to this network. With several routers the bars are the sum of all of them.",
   "gridPos": {
    "h": 8,
    "w": 24,
    "x": 0,
    "y": 5
   },
   "datasource": {
    "type": "influxdb",
    "uid": "InfluxDB_Flux"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "InfluxDB_Flux"
     },
     "query": "import \"array\"\n\n// ~96 buckets whatever the range, floored at the one-minute health tick, and\n// labelled by the start of each bucket -- the same derivation as the Suricata\n// dashboard, so zooming onto a bar selects the drops that drew it.\nspanNs = int(v: v.timeRangeStop) - int(v: v.timeRangeStart)\neveryNs = if spanNs / 96 < 60000000000 then 60000000000 else spanNs / 96\nevery = duration(v: everyNs)\n\nfrom(bucket: \"network_traffic\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"ip_reputation_router\" and r._field == \"rule_packets\")\n  |> aggregateWindow(every: every, fn: sum, createEmpty: true, timeSrc: \"_start\")\n  // one series per router: summed per bucket, after the pushed-down window\n  |> group()\n  |> aggregateWindow(every: every, fn: sum, createEmpty: true, timeSrc: \"_start\")\n  |> map(fn: (r) => ({r with _value: if exists r._value then r._value else 0}))\n  |> keep(columns: [\"_time\", \"_value\"])\n  |> rename(columns: {_value: \"Dropped packets\"})\n"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "influxdb",
      "uid": "InfluxDB_Flux"
     },
     "query": "from(bucket: \"network_traffic\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"ip_reputation_status\" and r._field == \"on_router\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\"])\n  |> rename(columns: {_value: \"Entries on router\"})\n"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "#3b82f6"
     },
     "custom": {
      "drawStyle": "bars",
      "lineWidth": 1,
      "fillOpacity": 85,
      "gradientMode": "none",
      "barAlignment": 1,
      "showPoints": "never",
      "axisSoftMin": 0
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Entries on router"
      },
      "properties": [
       {
        "id": "custom.drawStyle",
        "value": "line"
       },
       {
        "id": "custom.fillOpacity",
        "value": 0
       },
       {
        "id": "custom.axisPlacement",
        "value": "right"
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#9ca3af"
        }
       },
       {
        "id": "custom.lineWidth",
        "value": 2
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "none"
    }
   }
  },
  {
